{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sedentary-reminder",
  "version": "0.1.13",
  "identifier": "io.github.f95.sedentary-reminder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "久坐提醒（你的健康搭子）",
        "width": 520,
        "height": 800,
        "minWidth": 400,
        "minHeight": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "F-95",
    "copyright": "Copyright (c) 2026 F-95",
    "category": "Productivity",
    "shortDescription": "久坐提醒",
    "longDescription": "Sedentary Reminder - 跨平台久坐提醒桌面应用",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/F-95/sedentary-reminder/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFREEwRTY5QkUzN0QwMjgKUldRbzBEZSthUTdhWGlnSis1Mk9UTFZoeXBSOWNIc09QVmxhbjZVdTNQckl3NjY0V0o2Q2tRNm8K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
