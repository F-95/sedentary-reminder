{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sedentary-reminder",
  "version": "0.1.0",
  "identifier": "sedentary-reminder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "久坐提醒",
        "width": 520,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": { "active": false, "targets": "all", "icon": ["icons/CL.png"] }
}