# ========== 不应提交（构建产物 / 依赖 / 本地机密）==========
node_modules/
dist/
src-tauri/target/

# Vite 预构建缓存（Pre-bundling），随 `npm run dev` 自动生成
.vite/

# 环境变量与密钥
.env
.env.*
!.env.example

# 中文注释：Tauri 更新签名私钥（勿提交）；公钥见 tauri.conf.json 或 keys/*.pub
src-tauri/keys/*.key

# ========== 不应提交（补丁 / 插件运行时二进制与打包前端）==========
# 说明：manifest.json、rollback.json、schema 等元数据可提交；已编译的 backend/、frontend/ 为运行时产物，勿入库。
patches/**/backend/
patches/**/frontend/
plugins/**/backend/
plugins/**/frontend/

# ========== 不应提交（编辑器 / 系统杂项）==========
# Cursor IDE 本地规则与技能（Rules / Skills），属个人或本机配置
.cursor/
# Continue 扩展本地配置（与项目构建无关）
.continue/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.log

# JetBrains / Visual Studio 等（按需保留团队共享配置时再单独放行）
.idea/
*.suo
*.user

# CI / 本地由 scripts/changelog-for-release.mjs 生成的 Release 正文草稿
release-body.md

# 全局文档目录（推广草稿、个人笔记等，仅本地留存，不入库）
docs/global/

# 测试与工具缓存
coverage/
.eslintcache
*.tsbuildinfo
